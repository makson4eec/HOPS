{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "products": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "categoryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "siteCategory": {
            "type": "string",
            "enum": [
              "beer",
              "ciders",
              "poire",
              "beer_drinks",
              "lemonade",
              "snacks",
              "vapes"
            ]
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "barcode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000000,
            "multipleOf": 0.01
          },
          "stock": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "volume": {
            "default": "",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "unit": {
            "default": "pcs",
            "type": "string",
            "maxLength": 30
          },
          "alcohol": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 30
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "beerColor": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "light",
                  "dark"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "beerFiltration": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "filtered",
                  "unfiltered"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "shelfLifeDays": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "expiryDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "batches": {
            "default": [],
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "batchId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0
                },
                "expiryDate": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                }
              },
              "required": [
                "batchId",
                "quantity",
                "expiryDate"
              ],
              "additionalProperties": {}
            }
          },
          "imageUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "isNew": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "attributes": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "externalId",
          "categoryId",
          "siteCategory",
          "sku",
          "name",
          "description",
          "price",
          "stock",
          "volume",
          "unit",
          "batches",
          "isNew",
          "isActive",
          "updatedAt",
          "attributes"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schema_version",
    "export_id",
    "generated_at",
    "complete",
    "products"
  ],
  "additionalProperties": false,
  "title": "HOPS 1C catalog snapshot 1.0"
}
