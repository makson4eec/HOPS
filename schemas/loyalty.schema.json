{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "customers": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cardId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "balance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "operations": {
            "maxItems": 100000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "receiptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "ACCRUAL",
                    "REDEMPTION",
                    "REVERSAL"
                  ]
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "SUCCESS",
                    "PENDING",
                    "FAILED",
                    "REVERSED"
                  ]
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "operationId",
                "receiptId",
                "kind",
                "amount",
                "createdAt",
                "status",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "customerId",
          "cardId",
          "balance",
          "updatedAt",
          "operations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "export_id",
    "generated_at",
    "complete",
    "customers"
  ],
  "additionalProperties": false,
  "title": "HOPS 1C loyalty snapshot 1.0"
}
