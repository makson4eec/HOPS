// Модуль объекта внешней обработки для Розницы 2.3.26.24.
// Подключается в «Дополнительных отчетах и обработках».

Функция СведенияОВнешнейОбработке(ВерсияБСП = "") Экспорт
	Сведения = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке(ВерсияБСП);
	Сведения.Вид = "ДополнительнаяОбработка";
	Сведения.Версия = "1.0.0";
	Сведения.Наименование = "HOPS - выгрузка для сайта";
	Сведения.Информация = "Файловый обмен с сайтом HOPS: C:\HOPS\data\incoming.";
	Сведения.БезопасныйРежим = Ложь;
	ДобавитьКоманду(Сведения.Команды, "ПроверитьНастройки", "HOPS - проверить настройки");
	ДобавитьКоманду(Сведения.Команды, "ВыгрузитьКаталог", "HOPS - выгрузить каталог");
	ДобавитьКоманду(Сведения.Команды, "ВыгрузитьБонусы", "HOPS - выгрузить бонусы");
	Возврат Сведения;
КонецФункции

Процедура ДобавитьКоманду(Команды, Идентификатор, Представление)
	Команда = Команды.Добавить();
	Команда.Представление = Представление;
	Команда.Идентификатор = Идентификатор;
	Команда.Использование = "ВызовСерверногоМетода";
	Команда.ПоказыватьОповещение = Истина;
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды = Неопределено) Экспорт
	// Общая папка обмена, к которой Windows предоставляет доступ 1С и сайту.
	// BSLLS:UsingHardcodePath-off
	Папка = "C:\HOPS\data\incoming";
	// BSLLS:UsingHardcodePath-on
	Настройки = ПрочитатьНастройки(Папка);
	Если ИдентификаторКоманды = "ПроверитьНастройки" Тогда
		ЗаписатьДиагностику(Папка, Настройки);
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьКаталог" Тогда
		Склад = СкладПродажи(Настройки);
		ВидЦены = НайтиПоИмени("ВидыЦен", Настройки.priceType);
		Группы = ГруппыКаталога();
		ВыгрузитьКаталог(Папка, Склад, ВидЦены, Настройки.rubles, НастроитьГруппы(Настройки.groups, Группы));
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьБонусы" Тогда
		Программа = НайтиПоИмени("БонусныеПрограммыЛояльности", Настройки.bonusProgram);
		ВидКарты = НайтиПоИмени("ВидыДисконтныхКарт", Настройки.cardType);
		ВыгрузитьБонусы(Папка, Программа, ВидКарты);
	Иначе
		ВызватьИсключение "HOPS: неизвестная команда " + ИдентификаторКоманды;
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьНастройки(Папка)
	Путь = Папка + "\hops-1c.json";
	ФайлНастроек = Новый Файл(Путь);
	Если Не ФайлНастроек.Существует() Тогда
		ВызватьИсключение "HOPS: скопируйте файл настроек в " + Путь;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь, КодировкаТекста.UTF8);
	Попытка
		Настройки = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Настройки;
КонецФункции

Функция НайтиПоИмени(ИмяСправочника, Имя)
	ШаблонЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 2 Элементы.Ссылка КАК Ссылка
	|ИЗ Справочник.ИмяСправочника КАК Элементы
	|ГДЕ Элементы.Наименование = &Имя И НЕ Элементы.ПометкаУдаления";
	Запрос = Новый Запрос(СтрЗаменить(ШаблонЗапроса, "ИмяСправочника", ИмяСправочника));
	Запрос.УстановитьПараметр("Имя", Имя);
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() <> 1 Тогда
		ВызватьИсключение "HOPS: в справочнике " + ИмяСправочника + " ожидается одна запись «" + Имя + "».";
	КонецЕсли;
	Возврат Строки[0].Ссылка;
КонецФункции

Функция СкладПродажи(Настройки)
	Магазин = НайтиПоИмени("Магазины", Настройки.store);
	Склад = НайтиПоИмени("Склады", Настройки.warehouse);
	Если Магазин.СкладПродажи <> Склад Тогда
		ВызватьИсключение "HOPS: выбранный склад не совпадает со складом продажи в карточке магазина.";
	КонецЕсли;
	Возврат Склад;
КонецФункции

Функция ГруппыКаталога()
	Запрос = Новый Запрос("ВЫБРАТЬ Товары.Ссылка КАК Ссылка, Товары.Наименование КАК Имя,
	|Товары.Родитель КАК Родитель ИЗ Справочник.Номенклатура КАК Товары
	|ГДЕ Товары.ЭтоГруппа И НЕ Товары.ПометкаУдаления УПОРЯДОЧИТЬ ПО Имя");
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция НастроитьГруппы(НастройкиГрупп, Группы)
	Категории = Новый Соответствие;
	Для Каждого Настройка Из НастройкиГрупп Цикл
		Если СтрНайти(",beer,ciders,poire,beer_drinks,lemonade,snacks,vapes,", "," + Настройка.category + ",") = 0 Тогда
			ВызватьИсключение "HOPS: неизвестный код категории " + Настройка.category;
		КонецЕсли;
		Если Настройка.Свойство("id", Идентификатор) Тогда
			Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Строки = Группы.НайтиСтроки(Новый Структура("Ссылка", Ссылка));
		Иначе
			Строки = Группы.НайтиСтроки(Новый Структура("Имя", Настройка.name));
		КонецЕсли;
		Если Строки.Количество() <> 1 Тогда
			ВызватьИсключение "HOPS: группа «" + Настройка.name + "» отсутствует или неоднозначна. Проверьте диагностический файл.";
		КонецЕсли;
		Ссылка = Строки[0].Ссылка;
		Если Категории.Получить(Ссылка) <> Неопределено Тогда
			ВызватьИсключение "HOPS: группа задана дважды: " + Настройка.name;
		КонецЕсли;
		Категории.Вставить(Ссылка, Настройка.category);
	КонецЦикла;
	Если Категории.Количество() = 0 Тогда
		ВызватьИсключение "HOPS: укажите группы каталога в hops-1c.json.";
	КонецЕсли;
	Возврат Категории;
КонецФункции

Процедура ЗаписатьДиагностику(Папка, Настройки)
	Отчет = НовыйСнимок(МеткаUTC());
	Группы = ГруппыКаталога();
	Папки = Новый Массив;
	Для Каждого СтрокаГруппы Из Группы Цикл
		Папки.Добавить(Новый Структура("name,id,parentId", СтрокаГруппы.Имя,
			Строка(СтрокаГруппы.Ссылка.УникальныйИдентификатор()), Строка(СтрокаГруппы.Родитель.УникальныйИдентификатор())));
	КонецЦикла;
	Отчет.Вставить("groups", Папки);
	Попытка
		Склад = СкладПродажи(Настройки);
		ВидЦены = НайтиПоИмени("ВидыЦен", Настройки.priceType);
		Отчет.Вставить("warehouse", Строка(Склад));
		Отчет.Вставить("priceType", Строка(ВидЦены));
		Идентификаторы = Новый Массив;
		Для Каждого Группа Из НастроитьГруппы(Настройки.groups, Группы) Цикл
			Идентификаторы.Добавить(Строка(Группа.Ключ.УникальныйИдентификатор()));
		КонецЦикла;
		Отчет.Вставить("siteAllowlist", "ONE_C_ALLOWED_CATEGORY_IDS=" + СтрСоединить(Идентификаторы, ","));
	Исключение
		Отчет.Вставить("catalogError", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Программа = НайтиПоИмени("БонусныеПрограммыЛояльности", Настройки.bonusProgram);
		ВидКарты = НайтиПоИмени("ВидыДисконтныхКарт", Настройки.cardType);
		Отчет.Вставить("bonusProgram", Строка(Программа));
		Отчет.Вставить("cardType", Строка(ВидКарты));
		Отчет.Вставить("externalDiscountServer", ПолучитьФункциональнуюОпцию("ИспользоватьДисконтныйСервер"));
	Исключение
		Отчет.Вставить("loyaltyError", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗаписатьСнимок(Папка, "hops-1c-diagnostics.json", Отчет);
КонецПроцедуры

Функция КатегорияПива(Имя)
	Имя = НРег(Имя);
	Если СтрНайти(Имя, "пуарэ") > 0 Или СтрНайти(Имя, "poiré") > 0 Или СтрНайти(Имя, "poire") > 0 Тогда
		Возврат "poire";
	ИначеЕсли СтрНайти(Имя, "сидр") > 0 Или СтрНайти(Имя, "cider") > 0 Тогда
		Возврат "ciders";
	ИначеЕсли СтрНайти(Имя, "пив. нап") > 0 Или СтрНайти(Имя, "пивной напиток") > 0 Тогда
		Возврат "beer_drinks";
	КонецЕсли;
	Возврат "beer";
КонецФункции

Процедура ВыгрузитьКаталог(Папка, Склад, ВидЦены, КодыРубля, ГруппыСайта)
	Группы = Новый Массив;
	Для Каждого Группа Из ГруппыСайта Цикл
		Группы.Добавить(Группа.Ключ);
	КонецЦикла;
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток - Остатки.РезервОстаток) КАК Наличие,
	|	МАКСИМУМ(ВЫБОР КОГДА Остатки.Характеристика <> &ПустаяХарактеристика ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЕстьВарианты
	|ПОМЕСТИТЬ ОстаткиСклада
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Момент, Склад = &Склад) КАК Остатки
	|СГРУППИРОВАТЬ ПО Остатки.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	Товар.Ссылка КАК Товар,
	|	Товар.Родитель КАК Группа,
	|	Товар.Код КАК Код,
	|	Товар.Наименование КАК Наименование,
	|	Товар.Описание КАК Описание,
	|	Товар.ЕдиницаИзмерения.Наименование КАК Единица,
	|	Товар.Крепость КАК Крепость,
	|	ПРЕДСТАВЛЕНИЕ(Товар.СтранаПроисхождения) КАК Страна,
	|	ПРЕДСТАВЛЕНИЕ(Товар.Производитель) КАК Производитель,
	|	ЕСТЬNULL(Цена.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(Цена.Валюта, """") КАК Валюта,
	|	ЕСТЬNULL(ОстаткиСклада.Наличие, 0) КАК Наличие,
	|	ЕСТЬNULL(ОстаткиСклада.ЕстьВарианты, 0) КАК ЕстьВарианты
	|ИЗ Справочник.Номенклатура КАК Товар
	|	ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиСклада ПО ОстаткиСклада.Номенклатура = Товар.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|		&Момент, ВидЦены = &ВидЦены И Характеристика = &ПустаяХарактеристика) КАК Цена
	|	ПО Цена.Номенклатура = Товар.Ссылка
	|ГДЕ Товар.Ссылка В ИЕРАРХИИ (&Группы)
	|	И НЕ Товар.ЭтоГруппа И НЕ Товар.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО Товар.Код");
	Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Группы", Группы);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", ПустаяХарактеристика);

	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[1].Выбрать();
	Метка = МеткаUTC();
	Товары = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЕстьВарианты > 0 Тогда
			ВызватьИсключение "HOPS: для товара с кодом " + Выборка.Код + " нужно настроить выгрузку по характеристикам.";
		КонецЕсли;
		Валюта = НРег(СокрЛП(Выборка.Валюта));
		Если Выборка.Цена > 0 И Не ПустаяСтрока(Валюта) И КодыРубля.Найти(Валюта) = Неопределено Тогда
			ВызватьИсключение "HOPS: проверьте валюту розничной цены для товара с кодом " + Выборка.Код + ".";
		КонецЕсли;
		Единица = НРег(СокрЛП(Строка(Выборка.Единица)));
		Если Единица = "штука" Или Единица = "шт" Или Единица = "шт." Тогда
			Единица = "pcs";
		ИначеЕсли Единица = "л/дм3" Или Единица = "л/дм³" Или Единица = "литр" Тогда
			Единица = "л";
		КонецЕсли;
		Группа = Выборка.Группа;
		Пока ЗначениеЗаполнено(Группа) И ГруппыСайта.Получить(Группа) = Неопределено Цикл
			Группа = Группа.Родитель;
		КонецЦикла;
		Категория = ГруппыСайта.Получить(Группа);
		Если Категория = Неопределено Тогда
			ВызватьИсключение "HOPS: не найдена настроенная группа для товара с кодом " + Выборка.Код + ".";
		ИначеЕсли Категория = "beer" Тогда
			Категория = КатегорияПива(Выборка.Наименование);
		КонецЕсли;
		Товар = Новый Структура;
		Товар.Вставить("externalId", Строка(Выборка.Товар.УникальныйИдентификатор()));
		Товар.Вставить("categoryId", Строка(Группа.УникальныйИдентификатор()));
		Товар.Вставить("siteCategory", Категория);
		Товар.Вставить("sku", СокрЛП(Строка(Выборка.Код)));
		Товар.Вставить("name", Выборка.Наименование);
		Товар.Вставить("description", Строка(Выборка.Описание));
		Товар.Вставить("price", Окр(Выборка.Цена, 2));
		Товар.Вставить("stock", Макс(0, Выборка.Наличие));
		Товар.Вставить("unit", Единица);
		Товар.Вставить("alcohol", Выборка.Крепость);
		Товар.Вставить("country", Выборка.Страна);
		Товар.Вставить("manufacturer", Выборка.Производитель);
		Товар.Вставить("isNew", Ложь);
		Товар.Вставить("isActive", Истина);
		Товар.Вставить("updatedAt", Метка);
		Товары.Добавить(Товар);
	КонецЦикла;
	Если Товары.Количество() = 0 Тогда
		ВызватьИсключение "HOPS: в настроенных группах нет товаров. Сохранен предыдущий файл.";
	КонецЕсли;
	Снимок = НовыйСнимок(Метка);
	Снимок.Вставить("currency", "RUB");
	Снимок.Вставить("products", Товары);
	Снимок.Вставить("productCount", Товары.Количество());
	ЗаписатьСнимок(Папка, "catalog1.json", Снимок);
КонецПроцедуры

Процедура ВыгрузитьБонусы(Папка, БонуснаяПрограмма, ВидКарты)
	Если ПолучитьФункциональнуюОпцию("ИспользоватьДисконтныйСервер") Тогда
		ВызватьИсключение "HOPS: для внешнего дисконтного сервера требуется отдельная проверка источника баланса.";
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ Карты.Ссылка КАК Карта, Карты.ВладелецКарты КАК Владелец,
	|Карты.КартаДляНакоплений КАК КартаДляНакоплений
	|ИЗ Справочник.ИнформационныеКарты КАК Карты
	|ГДЕ Карты.БонуснаяПрограммаЛояльности = &Программа И Карты.ВидКарты = &ВидКарты И НЕ Карты.ПометкаУдаления");
	Запрос.УстановитьПараметр("Программа", БонуснаяПрограмма);
	Запрос.УстановитьПараметр("ВидКарты", ВидКарты);
	Выборка = Запрос.Выполнить().Выбрать();
	Момент = ТекущаяДатаСеанса();
	Метка = МеткаUTC();
	Клиенты = Новый Массив;
	Владельцы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Владелец) Тогда
			Продолжить;
		КонецЕсли;
		ИдКлиента = Строка(Выборка.Владелец.УникальныйИдентификатор());
		Карта = Выборка.Карта;
		Если ЗначениеЗаполнено(Выборка.КартаДляНакоплений) Тогда
			Карта = Выборка.КартаДляНакоплений;
			Если Карта.ПометкаУдаления Или Карта.ВладелецКарты <> Выборка.Владелец
				Или Карта.БонуснаяПрограммаЛояльности <> БонуснаяПрограмма Тогда
				ВызватьИсключение "HOPS: проверьте владельца и программу карты для накоплений.";
			КонецЕсли;
		КонецЕсли;
		ПредыдущаяКарта = Владельцы.Получить(ИдКлиента);
		Если ПредыдущаяКарта = Карта Тогда
			Продолжить;
		ИначеЕсли ПредыдущаяКарта <> Неопределено Тогда
			ВызватьИсключение "HOPS: в выбранной программе несколько карт у одного владельца. Сначала настройте выбор карты начисления.";
		КонецЕсли;
		Владельцы.Вставить(ИдКлиента, Карта);
		Баллы = БонусныеБаллыСервер.ТаблицаОстаткиИДвиженияБонусныхБаллов(Карта, Момент);
		ТекущиеОстатки = Баллы.НайтиСтроки(Новый Структура("ТекущийОстаток", Истина));
		Если ТекущиеОстатки.Количество() <> 1 Тогда
			ВызватьИсключение "HOPS: не удалось однозначно получить текущий бонусный остаток.";
		КонецЕсли;
		Клиенты.Добавить(Новый Структура("customerId,cardId,balance,updatedAt,historyAvailable,operations",
			ИдКлиента, Строка(Карта.УникальныйИдентификатор()), ТекущиеОстатки[0].Сумма, Метка, Ложь, Новый Массив));
	КонецЦикла;
	Снимок = НовыйСнимок(Метка);
	Снимок.Вставить("customers", Клиенты);
	Снимок.Вставить("total", Клиенты.Количество());
	ЗаписатьСнимок(Папка, "bonuska.json", Снимок);
КонецПроцедуры

Функция МеткаUTC()
	Момент = ТекущаяУниверсальнаяДата();
	Возврат Формат(Момент, "ДФ=yyyy-MM-dd") + "T" + Формат(Момент, "ДФ=HH:mm:ss") + "Z";
КонецФункции

Функция НовыйСнимок(Метка)
	Возврат Новый Структура("schema_version,export_id,generated_at,complete",
		"1.0", Строка(Новый УникальныйИдентификатор), Метка, Истина);
КонецФункции

Процедура ЗаписатьСнимок(Папка, ИмяФайла, Снимок)
	Если ПустаяСтрока(Папка) Тогда
		ВызватьИсключение "HOPS: укажите папку обмена.";
	КонецЕсли;
	Если Прав(Папка, 1) <> "\" Тогда
		Папка = Папка + "\";
	КонецЕсли;
	Путь = Папка + ИмяФайла;
	Временный = Путь + "." + Снимок.export_id + ".tmp";
	Предыдущий = Путь + ".previous";
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Временный, КодировкаТекста.UTF8);
	Попытка
		ЗаписатьJSON(Запись, Снимок);
	Исключение
		Запись.Закрыть();
		УдалитьФайлы(Временный);
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	ФайлНазначения = Новый Файл(Путь);
	ФайлРезерва = Новый Файл(Предыдущий);
	Попытка
		Если ФайлНазначения.Существует() Тогда
			Если ФайлРезерва.Существует() Тогда
				УдалитьФайлы(Предыдущий);
			КонецЕсли;
			ПереместитьФайл(Путь, Предыдущий);
		КонецЕсли;
		ПереместитьФайл(Временный, Путь);
	Исключение
		Если ФайлРезерва.Существует() И Не ФайлНазначения.Существует() Тогда
			ПереместитьФайл(Предыдущий, Путь);
		КонецЕсли;
		УдалитьФайлы(Временный);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры
