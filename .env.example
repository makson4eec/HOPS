# Copy to .env. Private files must stay outside public and .next.
HOPS_DATA_DIR=C:\HOPS\data
# Defaults: HOPS_DATA_DIR/incoming/catalog.json and incoming/loyalty.json
HOPS_CATALOG_FILE=
HOPS_LOYALTY_FILE=
# Имена файлов для модуля integrations/1c/HopsExport.bsl.
# HOPS_CATALOG_FILE=C:\HOPS\data\incoming\catalog1.json
# HOPS_LOYALTY_FILE=C:\HOPS\data\incoming\bonuska.json
# Deny import until at least one allowlist is configured. Exact 1C IDs, comma-separated.
ONE_C_ALLOWED_CATEGORY_IDS=
ONE_C_ALLOWED_PRODUCT_IDS=
APP_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
PORT=3000
# Optional SECOND local drive (S4U cannot access network shares).
HOPS_BACKUP_DIR=
HOPS_BACKUP_RETENTION_DAYS=30
NEXT_TELEMETRY_DISABLED=1
# Do not save ADMIN_PASSWORD here. Pass it temporarily to admin:create.
