# Copy to .env. Generate a unique URL-safe password, e.g. openssl rand -hex 32.
# Docker refuses to start while POSTGRES_PASSWORD is empty.
POSTGRES_USER=hops
POSTGRES_DB=hops
POSTGRES_PASSWORD=

# Used by npm commands outside Docker. Replace REPLACE_WITH_YOUR_PASSWORD.
# Docker Compose builds DATABASE_URL itself and uses the private db hostname.
DATABASE_URL=postgresql://hops:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/hops?schema=public

# Exact public origin, without trailing slash. HTTPS and COOKIE_SECURE=true on VPS.
APP_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
BIND_ADDRESS=127.0.0.1
PORT=3000

# Test adapter exchanges no invented products; live awaits the real 1C contract.
ONE_C_MODE=test
ONE_C_BASE_URL=
ONE_C_TOKEN=

# ADMIN_EMAIL and ADMIN_PASSWORD are passed only to admin:create, never committed.
